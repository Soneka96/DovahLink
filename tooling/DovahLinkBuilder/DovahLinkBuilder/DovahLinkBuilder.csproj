<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>DovahLinkBuilder.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputPath>../../out/DovahLinkBuilder/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DovahLinkBuilder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embeds the icon so MainWindow.xaml's relative Icon="DovahLinkBuilder.ico" resolves at runtime, in addition to ApplicationIcon above (which only sets the exe's own icon, not the in-window title bar icon). -->
    <Resource Include="DovahLinkBuilder.ico" />
  </ItemGroup>

</Project>
