<UserControl x:Class="DovahLink.DovahLinkBuilder.Ui.EnvironmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Button Content="Recheck" Command="{Binding RecheckCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ToolName}" FontWeight="Bold" Width="140" />
                                    <TextBlock Text="{Binding Availability}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="{Binding RemediationHint}" TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding RemediationActionLabel}" FontStyle="Italic" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,16,0,0" Padding="8" Background="#F0F0F0">
                <StackPanel>
                    <TextBlock Text="Git remote (informational)" FontWeight="Bold" />
                    <TextBlock Text="{Binding GitStatus.RemoteSyncState}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding GitStatusError}" Foreground="DarkOrange" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
