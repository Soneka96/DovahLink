<UserControl x:Class="DovahLink.DovahLinkBuilder.Ui.EnvironmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:DovahLink.DovahLinkBuilder">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,26,20">

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Environment" FontSize="20" FontWeight="Medium" Margin="0,0,0,4" />
                    <TextBlock Text="Toolchain discovery and diagnostics." Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RecheckCommand}" VerticalAlignment="Top" AutomationProperties.Name="Recheck">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BB;" Style="{StaticResource GlyphStyle}" FontSize="13" Margin="0,0,7,0" />
                        <AccessText Text="_Recheck" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="{Binding RefreshError, StringFormat='Could not check the environment: {0}'}" Foreground="{StaticResource BadBrush}"
                       FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding RefreshError, Converter={StaticResource NullToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Required to build" Style="{StaticResource CardLabelStyle}" Margin="0" />
                <TextBlock Text="&#160;&#8226;&#160;" Style="{StaticResource CardLabelStyle}" Margin="0" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CardLabelStyle}" Margin="0" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#x2715;" />
                                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Availability}" Value="{x:Static app:ToolchainAvailability.Found}">
                                                        <Setter Property="Text" Value="&#x2713;" />
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ToolName}" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,1,0,0"
                                                   Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding RemediationHint}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BadBgBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Availability}" Value="{x:Static app:ToolchainAvailability.Found}">
                                                        <Setter Property="Background" Value="{StaticResource OkBgBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10.5" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Missing" />
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static app:ToolchainAvailability.Found}">
                                                            <Setter Property="Text" Value="Ready" />
                                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" CornerRadius="10" Padding="13,15" Margin="0,0,0,14"
                                Background="{StaticResource BadBgBrush}" BorderBrush="{StaticResource BadBorderBrush}"
                                Visibility="{Binding RemediationActionLabel, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2715;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BadBrush}" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock FontWeight="Medium" FontSize="13.5">
                                        <Run Text="{Binding ToolName, Mode=OneWay}" /><Run Text=" was not found" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding RemediationHint}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    <TextBlock Text="{Binding RemediationActionLabel}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BadBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Source information &#8226; not required to build" Style="{StaticResource CardLabelStyle}" Margin="0,4,0,8" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x25C8;" Style="{StaticResource GlyphStyle}" Foreground="{StaticResource TextSecBrush}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Git remote verification" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="Used only for the source-state banner and history" Style="{StaticResource MutedTextStyle}" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding GitStatusError}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding GitStatusError, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="999" Padding="8,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GitStatus.RemoteSyncState}" Value="{x:Static app:RemoteSyncState.Pushed}">
                                        <Setter Property="Background" Value="{StaticResource OkBgBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GitStatus.RemoteSyncState}" Value="{x:Static app:RemoteSyncState.NotPushed}">
                                        <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GitStatus.WorkingTreeState}" Value="{x:Static app:WorkingTreeState.Dirty}">
                                        <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="10.5" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Could not check" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GitStatus.RemoteSyncState}" Value="{x:Static app:RemoteSyncState.Pushed}">
                                            <Setter Property="Text" Value="Pushed" />
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GitStatus.RemoteSyncState}" Value="{x:Static app:RemoteSyncState.NotPushed}">
                                            <Setter Property="Text" Value="Not pushed" />
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GitStatus.RemoteSyncState}" Value="{x:Static app:RemoteSyncState.CouldNotVerify}">
                                            <Setter Property="Text" Value="Committed, unverified" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GitStatus.WorkingTreeState}" Value="{x:Static app:WorkingTreeState.Dirty}">
                                            <Setter Property="Text" Value="Local changes" />
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
