<UserControl x:Class="DovahLink.DovahLinkBuilder.Ui.BuildPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:DovahLink.DovahLinkBuilder">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding BuildSummaryText}" FontSize="16" FontWeight="Bold" />
        <CheckBox Content="Clean build" IsChecked="{Binding IsCleanBuild}" IsEnabled="{Binding CanBuild}" Margin="0,12,0,0" />

        <TextBlock Text="{Binding BuildBlockedReason}"
                   Foreground="DarkOrange"
                   Margin="0,12,0,0"
                   Visibility="{Binding HasBuildBlockedReason, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding IsAwaitingConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="This build contains changes that are not committed or pushed."
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Content="Cancel" Command="{Binding CancelConfirmationCommand}" Margin="0,0,8,0" />
            <Button Content="Build anyway" Command="{Binding ConfirmBuildCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                    Visibility="{Binding CanShowBuildActions, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="Build" Command="{Binding BuildCommand}" Margin="0,0,8,0" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding LastOutcome, StringFormat='Last build: {0}'}" Margin="0,12,0,0" />
        <TextBlock Text="{Binding LastOutcomeMessage}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <ItemsControl ItemsSource="{Binding Stages}" Margin="0,16,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Height="8" Margin="2,0" ToolTip="{Binding DisplayName}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="LightGray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static app:BuildStageStatus.Running}">
                                        <Setter Property="Background" Value="DodgerBlue" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static app:BuildStageStatus.Succeeded}">
                                        <Setter Property="Background" Value="ForestGreen" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static app:BuildStageStatus.Failed}">
                                        <Setter Property="Background" Value="Crimson" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding StageProgressText}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
