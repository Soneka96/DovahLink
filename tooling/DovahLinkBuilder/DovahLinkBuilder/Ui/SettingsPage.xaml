<UserControl x:Class="DovahLink.DovahLinkBuilder.Ui.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,26,20">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Medium" Margin="0,0,0,4" />
            <TextBlock Text="Local build preferences." Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,18" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Paths" Style="{StaticResource CardLabelStyle}" />

                    <TextBlock Text="Repository path override" FontSize="13" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Browse&#8230;" Margin="8,0,0,0" Command="{Binding BrowseRepositoryPathCommand}"
                                    AutomationProperties.Name="Browse for repository path" />
                            <Button Content="Open folder" Margin="8,0,0,0" Command="{Binding OpenRepositoryFolderCommand}"
                                    AutomationProperties.Name="Open repository folder" />
                            <Button Content="Reset to auto-detect" Margin="8,0,0,0" Command="{Binding ResetRepositoryPathCommand}"
                                    AutomationProperties.Name="Reset repository path to auto-detect" />
                        </StackPanel>
                        <TextBox Text="{Binding EffectiveRepositoryPath, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 AutomationProperties.Name="Repository path" />
                    </DockPanel>
                    <TextBlock Text="{Binding RepositoryPathError}" Foreground="{StaticResource BadBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,-8,0,14"
                               Visibility="{Binding RepositoryPathError, Converter={StaticResource NullToVisibilityConverter}}" />

                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Skyrim / Creation Kit install path override" FontSize="13" />
                        <TextBlock Text="Auto-detected" Style="{StaticResource MutedTextStyle}" Margin="0,1,0,0" />
                    </StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Reset to auto-detect" Margin="8,0,0,0" Command="{Binding ResetSkyrimInstallPathCommand}"
                                AutomationProperties.Name="Reset Skyrim install path to auto-detect" />
                        <TextBox Text="{Binding SkyrimInstallPath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Skyrim / Creation Kit install path override" />
                    </DockPanel>

                    <TextBlock Text="Build output path override" FontSize="13" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reset to auto-detect" Margin="8,0,0,0" Command="{Binding ResetOutputPathCommand}"
                                AutomationProperties.Name="Reset build output path to auto-detect" />
                        <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Build output path override" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Behavior" Style="{StaticResource CardLabelStyle}" />

                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Open output folder after a successful build" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding OpenOutputFolderAfterSuccessfulBuild}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="Open output folder after a successful build" />
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Auto-scroll logs" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoScrollLogs}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="Auto-scroll logs" />
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Verbose command output" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding VerboseCommandOutput}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="Verbose command output" />
                    </Grid>
                    <Grid>
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Notify when build completes" FontSize="13" />
                            <TextBlock Text="Optional, useful for longer builds" Style="{StaticResource MutedTextStyle}" Margin="0,1,0,0" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding NotifyWhenBuildCompletes}" HorizontalAlignment="Right"
                                  AutomationProperties.Name="Notify when build completes" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
