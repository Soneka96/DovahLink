<Window x:Class="DovahLink.DovahLinkBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DovahLink.DovahLinkBuilder.Ui"
        xmlns:app="clr-namespace:DovahLink.DovahLinkBuilder"
        Title="DovahLink Builder" Icon="DovahLinkBuilder.ico"
        Height="700" Width="980" MinHeight="500" MinWidth="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type ui:BuildPageViewModel}">
            <ui:BuildPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:EnvironmentPageViewModel}">
            <ui:EnvironmentPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ui:SettingsPageViewModel}">
            <ui:SettingsPage />
        </DataTemplate>

        <Style x:Key="FooterStatusStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BuildPage.HasBuildBlockedReason}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BuildPage.LastOutcome}" Value="{x:Static app:BuildHistoryResult.Cancelled}">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BuildPage.LastOutcome}" Value="{x:Static app:BuildHistoryResult.Failed}">
                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BuildPage.IsBuilding}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BuildPage.IsCancelling}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="212" Background="{StaticResource NavBgBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,20">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBgBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                            <TextBlock Text="DL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="DovahLink Builder" FontWeight="Medium" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BuildPage.HasMissingRequiredTool}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel>
                                <TextBlock Text="Environment" FontSize="12" FontWeight="Medium" />
                                <TextBlock Text="{Binding BuildPage.EnvironmentSummaryText}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <ToggleButton Style="{StaticResource NavItemStyle}" IsChecked="{Binding IsBuildPageActive, Mode=OneWay}"
                                      Command="{Binding NavigateToBuildCommand}" AutomationProperties.Name="Build">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25B6;" Style="{StaticResource GlyphStyle}" Width="18" />
                                <AccessText Text="_Build" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource NavItemStyle}" IsChecked="{Binding IsEnvironmentPageActive, Mode=OneWay}"
                                      Command="{Binding NavigateToEnvironmentCommand}" AutomationProperties.Name="Environment">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25C8;" Style="{StaticResource GlyphStyle}" Width="18" />
                                <AccessText Text="_Environment" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource NavItemStyle}" IsChecked="{Binding IsSettingsPageActive, Mode=OneWay}"
                                      Command="{Binding NavigateToSettingsCommand}" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2699;" Style="{StaticResource GlyphStyle}" Width="18" />
                                <AccessText Text="_Settings" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource NavBgBrush}" BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="22,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MutedTextStyle}">
                            <Run Text="v" /><Run Text="{Binding BuildPage.RepositoryVersion, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="18,0,0,0">
                            <Run Text="{Binding BuildPage.GitBranch, Mode=OneWay}" /><Run Text=" &#8226; " />
                            <Run Text="{Binding BuildPage.GitFooterStateText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Margin="18,0,0,0"
                                    Visibility="{Binding BuildPage.DotNetVersionDetail, Converter={StaticResource NullToVisibilityConverter}}">
                            <Run Text=".NET " /><Run Text="{Binding BuildPage.DotNetVersionDetail, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding BuildPage.FooterStatusText}" Style="{StaticResource FooterStatusStyle}"
                                    HorizontalAlignment="Right" Margin="18,0,0,0" />
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding CurrentPage}" />
            </DockPanel>
        </DockPanel>

        <Border x:Name="CloseOverlay" Background="#9E06070C" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="22" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="A build is currently running" FontSize="14" FontWeight="Medium" Margin="0,0,0,4" />
                    <TextBlock Text="Closing the Builder will cancel it." Style="{StaticResource SubtleTextStyle}" Margin="0,0,0,16" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="KeepBuildingButton" Content="Keep building" Click="OnKeepBuildingClick" Margin="0,0,8,0" />
                        <Button x:Name="CancelBuildAndCloseButton" Content="Cancel build and close" Style="{StaticResource DangerButtonStyle}"
                                Click="OnCancelBuildAndCloseClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
