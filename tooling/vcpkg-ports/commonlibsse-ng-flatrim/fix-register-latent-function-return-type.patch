Fix RE::NativeLatentFunction's constructor assigning an unevaluated GetRawType<T>
functor object into _retType instead of invoking it, which fails to compile for
every latent return type. The sibling non-latent path in NativeFunction.h already
calls the functor correctly (GetRawType<result_type>{}()); this applies the same
fix here.

--- a/include/RE/N/NativeLatentFunction.h
+++ b/include/RE/N/NativeLatentFunction.h
@@ -28,7 +28,7 @@
 			NativeLatentFunction(std::string_view a_fnName, std::string_view a_className, function_type a_callback) :
 				NativeFunction<IS_LONG, F, std::underlying_type_t<callbackR>, Base, Args...>(a_fnName, a_className, a_callback)
 			{
-				this->_retType = GetRawType<latentR>();
+				this->_retType = GetRawType<latentR>{}();
 				this->_isLatent = true;
 			}
 
