{
    "cmake.sourceDirectory": "${workspaceFolder}/adapter",
    "cmake.useCMakePresets": "always",
    "cmake.exportCompileCommandsFile": true,
    "files.exclude": {
        "**/adapter/build/**": true,
        "**/adapter/vcpkg_installed/**": true,
        "**/app/build/**": true,
        "**/app/.dart_tool/**": true,
        "**/app/**/ephemeral/**": true
    },
    "search.exclude": {
        "**/adapter/build/**": true,
        "**/adapter/vcpkg_installed/**": true,
        "**/app/build/**": true,
        "**/app/.dart_tool/**": true,
        "**/app/**/ephemeral/**": true
    },
    "files.watcherExclude": {
        "**/adapter/build/**": true,
        "**/adapter/vcpkg_installed/**": true,
        "**/app/build/**": true,
        "**/app/.dart_tool/**": true,
        "**/app/**/ephemeral/**": true
    },
    "dart.analysisExcludedFolders": [
        "${workspaceFolder}/app/build",
        "${workspaceFolder}/app/.dart_tool",
        "${workspaceFolder}/app/linux/flutter/ephemeral",
        "${workspaceFolder}/app/windows/flutter/ephemeral",
        "${workspaceFolder}/app/macos/Flutter/ephemeral"
    ]
}
