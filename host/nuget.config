<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources of the Host projects. SasPairing is mapped only to the local feed that
  tooling/sas_pairing_dependency.py builds and verifies from the commit pinned in
  host/sas-pairing-dependency.json, so it can never resolve from nuget.org or another source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="sas-pairing-pinned" value="../out/sas-pairing/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="sas-pairing-pinned">
      <package pattern="SasPairing" />
    </packageSource>
  </packageSourceMapping>
</configuration>
