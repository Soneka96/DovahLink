<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Restores into the ignored out/ folder so the transitively referenced SasPairing build is
         never served from a stale shared package cache. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\..\out\sas-pairing\packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DovahLink.Host\DovahLink.Host.csproj" />
    <ProjectReference Include="..\DovahLink.Host.PairingCeremony\DovahLink.Host.PairingCeremony.csproj" />
    <!-- Build-only: the real-native tests launch the test peer as a separate process; its assembly is never referenced. -->
    <ProjectReference Include="..\DovahLink.Host.PairingCeremony.TestPeer\DovahLink.Host.PairingCeremony.TestPeer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\adapter-host-ipc\fixtures\private-ipc-limits.json"
          Link="adapter-host-ipc\fixtures\private-ipc-limits.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\adapter-host-ipc\fixtures\live-state-catalog.json"
          Link="adapter-host-ipc\fixtures\live-state-catalog.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\protocol\fixtures\connection\hello-ack.json"
          Link="protocol\fixtures\connection\hello-ack.json"
          CopyToOutputDirectory="PreserveNewest" />
