<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test infrastructure only: a separate process that plays a controlled sas-pairing peer for the
    dormant Host integration's real-native tests, through the public SasPairing package alone. It is
    never packaged, published, referenced by the Host, or composed into the product.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- Restores into the ignored out/ folder so a re-acquired SasPairing build of the same version
         is never served from a stale shared package cache. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)..\..\out\sas-pairing\packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exactly the version host/sas-pairing-dependency.json pins, built by tooling/sas_pairing_dependency.py. -->
    <PackageReference Include="SasPairing" Version="[0.1.0-dev.1]" />
  </ItemGroup>

</Project>
